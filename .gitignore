# Publication gate markers are LOCAL control files and must never be committed.
# The lock system specifies them as local: a bot that only sees the remote still
# has to consult the working copy before changing visibility.
PRIVATE.txt
PUBLIC.txt

# Local locks
LOCK.txt
LOCK.*.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
*.swp
