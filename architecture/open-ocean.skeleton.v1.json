  "recipe_source": {
    "repository": "ellmos-ai/bundles",
    "role": "the recipe layer; manifests are maintained and released there, wave by wave",
    "why_separate": "Recipes are ready months before the system that consumes them. Carrying copies here would make this repository look finished while the system is not, and would fork the manifests the moment the recipe repo moves on."
  },
