# Publication gate markers [U 2026-08-08]
# PRIVATE.txt and PUBLIC.txt are deliberately NOT ignored:
# the publication gate belongs at the remote, where visibility is switched.
# Only folders without a repository keep purely local markers.

# Local locks and multi-agent coordination
LOCK
LOCK.*
LOCK.txt
LOCK.*.txt
LOCK*.txt
*.lock
LOCK.permissions.json

# Synchronization and conflict copies
*.sync-conflict-*
*.conflict
*-CONFLIT-*
*-conflict-*
*.sync-temp-*
*-WORKSTATION*
*-ASUS-*
* (kopie)*
* (copy)*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Build, packaging & wheels
build/
dist/
*.egg-info/
wheelhouse/
.wheel-smoke/

# Testing, linting, and coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Temporary and backup files
*.tmp
*.bak
*~

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
