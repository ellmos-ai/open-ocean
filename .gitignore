# PRIVATE.txt and PUBLIC.txt are deliberately NOT ignored [U 2026-08-08]:
# the publication gate belongs at the remote, where visibility is switched.
# Only folders without a repository keep purely local markers.

# Local locks
LOCK.txt
LOCK.*.txt
LOCK*.txt
*.lock

# Synchronization and conflict copies
*.sync-conflict-*
*.conflict
*-CONFLIT-*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Build & packaging
build/
dist/
*.egg-info/

# Testing, linting, and coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Temporary and backup files
*.tmp
*.bak
*~

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
